{
  "name": "pickle",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "bootstrap": "pnpm install && pnpm --filter @pickle/app exec expo install --fix",
    "start": "pnpm --filter @pickle/app start",
    "web": "pnpm --filter @pickle/app web",
    "android": "pnpm --filter @pickle/app android",
    "build:web": "pnpm --filter @pickle/app build:web",
    "test": "pnpm --filter @pickle/core test",
    "typecheck": "pnpm --filter @pickle/core typecheck && pnpm --filter @pickle/app typecheck"
  }
}
